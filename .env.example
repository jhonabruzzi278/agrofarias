# ============================================
# SECURITY WARNING
# ============================================
# NEVER commit .env to version control.
# Add your real secrets in Vercel Dashboard:
# https://vercel.com/dashboard > Project > Settings > Environment Variables
#
# Rotate WooCommerce keys IMMEDIATELY if they were ever exposed in git history.
# ============================================

# WooCommerce REST API
WORDPRESS_URL=https://api.tu-dominio.com
WC_CONSUMER_KEY=ck_tu_consumer_key_aqui
WC_CONSUMER_SECRET=cs_tu_consumer_secret_aqui
WC_API_VERSION=wc/v3

# Sanity
SANITY_PROJECT_ID=tu_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_USE_CDN=true

# Cotizaciones
COTIZACIONES_EMAIL=contacto@tudominio.com
COTIZADOR_PASSWORD=tu_password_aqui
# Secreto para firmar la cookie de sesión del admin (HMAC).
# Genera uno fuerte y único, p.ej.: openssl rand -base64 32
# Si no se define, se deriva de COTIZADOR_PASSWORD (menos recomendable).
SESSION_SECRET=cambia_esto_por_un_secreto_aleatorio_largo

# ELEX Quote API Endpoint
ELEX_QUOTE_ENDPOINT=/wp-json/elex-rfq/v1/quote/create
