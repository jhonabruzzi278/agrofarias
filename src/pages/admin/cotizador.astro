---
export const prerender = false;
const password = import.meta.env.COTIZADOR_PASSWORD as string;

console.log('[cotizador-page] PASSWORD from env:', password ? 'SET (' + password.length + ' chars)' : 'NOT SET');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Cotizador Interno — Agro Farías</title>
  <link rel="icon" type="image/png" href="/logo-agrofarias.png" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:system-ui,-apple-system,Helvetica Neue,Arial,sans-serif;background:#f9fafb;min-height:100vh}
    .container{max-width:1280px;margin:0 auto}
    .bg-white{background:#fff}.bg-gray-50{background:#f9fafb}.bg-green-600{background:#16a34a}.bg-green-700{background:#15803d}.bg-green-50{background:#f0fdf4}
    .bg-red-50{background:#fef2f2}.bg-gray-100{background:#f3f4f6}.bg-gray-800{background:#1f2937}
    .text-white{color:#fff}.text-gray-400{color:#9ca3af}.text-gray-500{color:#6b7280}.text-gray-600{color:#4b5563}.text-gray-700{color:#374151}.text-gray-800{color:#1f2937}
    .text-green-700{color:#15803d}.text-green-800{color:#166534}.text-red-500{color:#ef4444}.text-red-600{color:#dc2626}.text-red-700{color:#b91c1c}
    .rounded-lg{border-radius:.5rem}.rounded-xl{border-radius:.75rem}.rounded-full{border-radius:9999px}
    .border{border:1px solid #e5e7eb}.border-gray-200{border-color:#e5e7eb}.border-gray-300{border-color:#d1d5db}.border-green-200{border-color:#bbf7d0}.border-red-200{border-color:#fecaca}
    .shadow-sm{box-shadow:0 1px 2px rgba(0,0,0,.05)}.shadow{box-shadow:0 1px 3px rgba(0,0,0,.1)}.shadow-lg{box-shadow:0 10px 15px -3px rgba(0,0,0,.1)}
    .p-2{padding:.5rem}.p-3{padding:.75rem}.p-4{padding:1rem}.p-5{padding:1.25rem}.p-8{padding:2rem}.p-12{padding:3rem}
    .px-2{padding-left:.5rem;padding-right:.5rem}.px-3{padding-left:.75rem;padding-right:.75rem}.px-4{padding-left:1rem;padding-right:1rem}
    .py-0\.5{padding-top:.125rem;padding-bottom:.125rem}.py-1{padding-top:.25rem;padding-bottom:.25rem}.py-1\.5{padding-top:.375rem;padding-bottom:.375rem}
    .py-2{padding-top:.5rem;padding-bottom:.5rem}.py-2\.5{padding-top:.625rem;padding-bottom:.625rem}.py-3{padding-top:.75rem;padding-bottom:.75rem}
    .py-10{padding-top:2.5rem;padding-bottom:2.5rem}
    .pt-3{padding-top:.75rem}.pt-5{padding-top:1.25rem}.pt-10{padding-top:2.5rem}
    .pb-2{padding-bottom:.5rem}.pl-5{padding-left:1.25rem}
    .mt-1{margin-top:.25rem}.mt-3{margin-top:.75rem}.mt-4{margin-top:1rem}.mb-1{margin-bottom:.25rem}.mb-3{margin-bottom:.75rem}.mb-4{margin-bottom:1rem}.mb-6{margin-bottom:1.5rem}.ml-1{margin-left:.25rem}.ml-2{margin-left:.5rem}.gap-1{gap:.25rem}.gap-2{gap:.5rem}.gap-3{gap:.75rem}.gap-4{gap:1rem}.gap-6{gap:1.5rem}
    .flex{display:flex}.grid{display:grid}.block{display:block}.inline-flex{display:inline-flex}
    .items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}
    .flex-1{flex:1}.shrink-0{flex-shrink:0}.w-full{width:100%}.w-fit{width:fit-content}.w-8{width:2rem}.w-10{width:2.5rem}.w-12{width:3rem}.w-16{width:4rem}.w-20{width:5rem}.w-28{width:7rem}.w-32{width:8rem}
    .h-8{height:2rem}.h-12{height:3rem}.max-w-sm{max-width:24rem}.max-w-7xl{max-width:80rem}
.min-h-screen{min-height:100vh}.min-w-0{min-width:0}
    .text-xs{font-size:.75rem}.text-sm{font-size:.875rem}.text-lg{font-size:1.125rem}.text-xl{font-size:1.25rem}.text-2xl{font-size:1.5rem}.text-3xl{font-size:1.875rem}.text-4xl{font-size:2.25rem}
    .font-medium{font-weight:500}.font-semibold{font-weight:600}.font-bold{font-weight:700}
    .text-center{text-align:center}.text-left{text-align:left}.text-right{text-align:right}
    .uppercase{text-transform:uppercase}.tracking-wide{letter-spacing:.025em}
    .truncate{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.leading-relaxed{line-height:1.625}.leading-none{line-height:1}
    .object-cover{object-fit:cover}.overflow-hidden{overflow:hidden}.overflow-x-auto{overflow-x:auto}.overflow-y-auto{overflow-y:auto}
    .relative{position:relative}.absolute{position:absolute}.fixed{position:fixed}.inset-y-0{top:0;bottom:0}.top-0{top:0}.left-0{left:0}.left-2{left:.5rem}.right-0{right:0}
    .z-10{z-index:10}.transition{transition:all .15s ease}
    .hover\\:bg-green-800:hover{background:#166534}.hover\\:bg-gray-50:hover{background:#f9fafb}.hover\\:shadow:hover{box-shadow:0 1px 3px rgba(0,0,0,.1)}
    .hover\\:text-red-600:hover{color:#dc2626}.hover\\:text-white:hover{color:#fff}
    .outline-none{outline:2px solid transparent}.focus\\:ring-2:focus{box-shadow:0 0 0 2px rgba(34,197,94,.5)}.focus\\:border-green-500:focus{border-color:#22c55e}
    .line-clamp-2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .cursor-pointer{cursor:pointer}.pointer-events-none{pointer-events:none}.opacity-0{opacity:0}.opacity-100{opacity:1}
    .hidden{display:none}
    .space-y-1>*+*{margin-top:.25rem}.space-y-2>*+*{margin-top:.5rem}.space-y-3>*+*{margin-top:.75rem}.space-y-4>*+*{margin-top:1rem}.space-y-5>*+*{margin-top:1.25rem}
    .border-t{border-top:1px solid #e5e7eb}.border-b{border-bottom:1px solid #e5e7eb}
    @media(min-width:640px){.sm\\:p-6{padding:1.5rem}.sm\\:grid-cols-2{grid-template-columns:repeat(2,1fr)}.sm\\:grid-cols-3{grid-template-columns:repeat(3,1fr)}}
    @media(min-width:1024px){.lg\\:p-8{padding:2rem}.lg\\:col-span-2{grid-column:span 2}.lg\\:col-span-3{grid-column:span 3}.lg\\:grid-cols-5{grid-template-columns:repeat(5,1fr)}}
    @media(min-width:768px){.md\\:grid-cols-3{grid-template-columns:repeat(3,1fr)}}
    .grid-cols-1{grid-template-columns:repeat(1,1fr)}
  </style>
</head>
<body>
  <div id="app-root">
    <div class="min-h-screen flex items-center justify-center px-4" id="login-screen">
      <div class="w-full max-w-sm">
        <div class="bg-white rounded-xl shadow-lg p-8">
          <div class="text-center mb-6">
            <div class="text-4xl mb-3">&#x1F512;</div>
            <h1 class="text-xl font-bold text-gray-800">Cotizador Interno</h1>
            <p class="text-sm text-gray-500 mt-1">Agro Farías</p>
          </div>
          <div id="login-form">
            <label class="block text-sm font-medium text-gray-600 mb-1">Contraseña</label>
            <input type="password" id="password-input" required autofocus
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:border-green-500 outline-none" style="transition:all .15s"
              placeholder="Ingresá la contraseña" />
            <button id="login-btn" class="w-full mt-4 bg-green-700 hover:bg-green-800 text-white font-medium py-2.5 rounded-lg transition" style="transition:all .15s">
              Ingresar
            </button>
          </div>
          <p id="login-error" class="text-red-600 text-sm text-center mt-4 hidden">Contraseña incorrecta</p>
          <p id="login-config-error" class="text-red-600 text-sm text-center mt-4 hidden">Cotizador no configurado. Agregá COTIZADOR_PASSWORD en Vercel.</p>
          <p id="debug-password" class="text-xs text-gray-400 text-center mt-3"></p>
        </div>
      </div>
    </div>
    <div id="admin-panel" class="pt-10 hidden">
      <div class="fixed top-0 left-0 right-0 bg-green-700 text-white text-xs px-4 py-2 flex items-center justify-between z-10">
        <span>Cotizador Interno — Agro Farías</span>
        <button id="logout-btn" class="text-white/80 hover:text-white underline cursor-pointer" style="background:none;border:none;font-size:.75rem">Salir</button>
      </div>
      <div id="cotizador-root"></div>
    </div>
    <div id="loading-screen" class="flex items-center justify-center hidden" style="min-height:60vh">
      <p class="text-gray-400 text-sm">Cargando...</p>
    </div>
  </div>

  <script type="module" define:vars={{ password }}>
    const PASSWORD = password || '';
    console.log('[cotizador] PASSWORD value:', PASSWORD);
    console.log('[cotizador] PASSWORD length:', PASSWORD.length);
    console.log('[cotizador] PASSWORD === "agrofarias2025":', PASSWORD === 'agrofarias2025');
    const debugEl = document.getElementById('debug-password');
    debugEl.textContent = 'DEBUG: Password ' + (PASSWORD ? 'SET (' + PASSWORD.length + ' chars, starts with "' + PASSWORD.slice(0,3) + '...")' : 'NOT SET - revisá Vercel env vars');
    const AUTH_KEY = 'agrofarias-cotizador-auth';
    const loginScreen = document.getElementById('login-screen');
    const adminPanel = document.getElementById('admin-panel');
    const loadingScreen = document.getElementById('loading-screen');
    const loginError = document.getElementById('login-error');
    const configError = document.getElementById('login-config-error');
    const loginBtn = document.getElementById('login-btn');
    const logoutBtn = document.getElementById('logout-btn');
    const passwordInput = document.getElementById('password-input');

    function checkAuth() {
      if (!PASSWORD) {
        configError.classList.remove('hidden');
        return false;
      }
      return localStorage.getItem(AUTH_KEY) === PASSWORD;
    }

    function showLogin(silent) {
      loginScreen.classList.remove('hidden');
      adminPanel.classList.add('hidden');
      loadingScreen.classList.add('hidden');
      if (!silent) {
        loginError.classList.remove('hidden');
        setTimeout(() => loginError.classList.add('hidden'), 3000);
      }
    }

    async function showApp() {
      loginScreen.classList.add('hidden');
      adminPanel.classList.remove('hidden');
      loadingScreen.classList.remove('hidden');
      console.log('[showApp] starting...');

      try {
        const headers = { 'Content-Type': 'application/json', 'X-Cotizador-Auth': PASSWORD };
        console.log('[showApp] fetching APIs...');
        const [prodRes, quotesRes] = await Promise.all([
          fetch('/api/cotizador-interno/productos', { headers }),
          fetch('/api/cotizador-interno/quotes', { headers }),
        ]);
        console.log('[showApp] productos status:', prodRes.status);
        console.log('[showApp] quotes status:', quotesRes.status);
        const productos = prodRes.ok ? await prodRes.json() : (console.warn('[showApp] productos failed'), []);
        const quotes = quotesRes.ok ? await quotesRes.json() : (console.warn('[showApp] quotes failed'), []);
        console.log('[showApp] productos count:', productos.length);
        console.log('[showApp] quotes count:', quotes.length);
        loadingScreen.classList.add('hidden');

        console.log('[showApp] importing Vue...');
        const loadMsg = document.getElementById('admin-panel').querySelector('#cotizador-root');
        loadMsg.innerHTML = '<p class="text-gray-400 text-sm text-center py-20">Cargando aplicación...</p>';

        let VueModule;
        try {
          VueModule = await import('/js/vue.esm-browser.prod.js');
        } catch (vueErr) {
          console.error('[showApp] Vue import failed:', vueErr);
          loadingScreen.classList.remove('hidden');
          loadingScreen.innerHTML = '<p class="text-red-500 text-sm">Error al cargar Vue. Recargá la página o verificá la conexión.</p>';
          return;
        }
        const { createApp, ref, computed } = VueModule;
        console.log('[showApp] Vue loaded, mounting...');

        createApp({
          setup() {
            const tab = ref('nueva');
            const allProducts = ref(productos);
            const quoteQuotes = ref(quotes);
            const searchTerm = ref('');
            const quoteItems = ref([]);
            const customerName = ref(''); const customerEmail = ref(''); const customerPhone = ref('');
            const customerCompany = ref(''); const customerMessage = ref('');
            const sending = ref(false); const result = ref(null); const loadingQuotes = ref(false);

            const filteredProducts = computed(() => {
              if (!searchTerm.value.trim()) return [];
              const t = searchTerm.value.toLowerCase().trim();
              return allProducts.value.filter(p => p.name.toLowerCase().includes(t)).slice(0, 20);
            });
            const total = computed(() => quoteItems.value.reduce((s, i) => s + i.cantidad * i.precioUnitario, 0));
            const totalProducts = computed(() => quoteItems.value.reduce((s, i) => s + i.cantidad, 0));

            function fp(n) { return n === 0 ? '$0' : '$' + n.toLocaleString('es-CL'); }
            function fd(d) { return new Date(d).toLocaleDateString('es-CL', { day:'2-digit', month:'2-digit', year:'numeric' }); }
            function sl(s) { const m={processing:'Procesando',completed:'Completado',pending:'Pendiente','on-hold':'En espera',cancelled:'Cancelado'}; return m[s]||s; }
            function sc(s) { const m={processing:'color:#1d4ed8;background:#dbeafe',completed:'color:#166534;background:#dcfce7',pending:'color:#854d0e;background:#fef9c3','on-hold':'color:#9a3412;background:#ffedd5',cancelled:'color:#991b1b;background:#fee2e2'}; return m[s]||'color:#4b5563;background:#f3f4f6'; }

            function hp(id) { return quoteItems.value.some(i => i.producto.id === id); }
            function ap(p) { if (!hp(p.id)) { quoteItems.value.push({ producto: p, cantidad: 1, precioUnitario: 0 }); searchTerm.value = ''; } }
            function ri(idx) { quoteItems.value.splice(idx, 1); }
            function cc(idx, v) { quoteItems.value[idx].cantidad = Math.max(1, Math.min(999, Math.round(v))); }
            function pc(idx, v) { quoteItems.value[idx].precioUnitario = Math.max(0, Math.round(v)); }

            async function rq() { loadingQuotes.value = true; try { const r = await fetch('/api/cotizador-interno/quotes', { headers }); if (r.ok) quoteQuotes.value = await r.json(); } catch{}; loadingQuotes.value = false; }

            async function hs() {
              result.value = null;
              if (quoteItems.value.length === 0) { result.value = { ok: false, message: 'Agregá al menos un producto.' }; return; }
              if (!customerName.value.trim()) { result.value = { ok: false, message: 'Ingresá el nombre.' }; return; }
              if (!customerEmail.value.trim()) { result.value = { ok: false, message: 'Ingresá el email.' }; return; }
              if (!customerPhone.value.trim()) { result.value = { ok: false, message: 'Ingresá el teléfono.' }; return; }
              sending.value = true;
              try {
                const r = await fetch('/api/cotizador-interno', { method: 'POST', headers, body: JSON.stringify({
                  productos: quoteItems.value.map(i => ({ id: i.producto.id, name: i.producto.name, cantidad: i.cantidad, precioUnitario: i.precioUnitario })),
                  nombre: customerName.value.trim(), email: customerEmail.value.trim(), telefono: customerPhone.value.trim(),
                  empresa: customerCompany.value.trim() || null, mensaje: customerMessage.value.trim() || null,
                })});
                const d = await r.json();
                if (r.ok) { result.value = { ok: true, message: 'Cotización enviada correctamente.' }; quoteItems.value = []; customerName.value = ''; customerEmail.value = ''; customerPhone.value = ''; customerCompany.value = ''; customerMessage.value = ''; rq(); }
                else { result.value = { ok: false, message: d.error || 'Error al enviar.' }; }
              } catch { result.value = { ok: false, message: 'Error de conexión.' }; }
              sending.value = false;
            }

            function logout() { localStorage.removeItem(AUTH_KEY); location.reload(); }

            return { tab, allProducts, quoteQuotes, searchTerm, quoteItems, filteredProducts,
              customerName, customerEmail, customerPhone, customerCompany, customerMessage,
              sending, result, loadingQuotes, total, totalProducts,
              hp, ap, ri, cc, pc, fp, fd, sl, sc, hs, rq, logout };
          },
          template: /*html*/`
<div class="min-h-screen p-4 sm:p-6 lg:p-8"><div class="max-w-7xl mx-auto">
<div class="flex items-center gap-3 mb-6"><span class="text-3xl">&#128221;</span><h1 class="text-2xl font-bold text-gray-800">Cotizador Interno</h1><span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background:#dcfce7;color:#166534">Admin</span></div>

<div class="flex gap-1 mb-6 bg-gray-100 rounded-xl p-1 w-fit">
<button @click="tab='nueva'" :style="tab==='nueva'?'background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.05)':'background:transparent'" class="px-4 py-2 rounded-lg text-sm font-medium transition" style="border:none;cursor:pointer;color:inherit">Nueva cotización</button>
<button @click="tab='recibidas';rq()" :style="tab==='recibidas'?'background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.05)':'background:transparent'" class="px-4 py-2 rounded-lg text-sm font-medium transition" style="border:none;cursor:pointer">Cotizaciones recibidas <span class="text-xs text-gray-400 ml-1">{{ quoteQuotes.length }}</span></button>
</div>

<div v-show="tab==='nueva'" class="grid grid-cols-1 lg:grid-cols-5 gap-6">
<div class="lg:col-span-2 space-y-4">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5"><h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Buscar producto</h2><input v-model="searchTerm" type="text" placeholder="Escribí el nombre..." class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:border-green-500 outline-none transition text-sm" /><div v-if="searchTerm.trim()" class="mt-1 text-xs text-gray-400">{{ filteredProducts.length }} resultado{{ filteredProducts.length !== 1 ? 's' : '' }}</div></div>
<div v-if="searchTerm.trim()" class="space-y-2 overflow-y-auto" style="max-height:calc(100vh - 320px)">
<div v-if="filteredProducts.length === 0" class="text-center text-gray-400 py-10 text-sm">No se encontraron.</div>
<div v-for="p in filteredProducts" :key="p.id" class="flex items-center gap-3 bg-white rounded-lg border border-gray-200 p-3 shadow-sm hover:shadow transition"><img :src="p.image" :alt="p.name" class="w-12 h-12 rounded-lg object-cover bg-gray-100 shrink-0" /><div class="flex-1 min-w-0"><p class="text-sm font-medium text-gray-800 truncate">{{ p.name }}</p></div><button v-if="!hp(p.id)" @click="ap(p)" class="shrink-0 bg-green-600 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition" style="border:none;cursor:pointer;background:#16a34a">+ Agregar</button><span v-else class="shrink-0 text-xs text-gray-400 bg-gray-100 px-3 py-1.5 rounded-lg">Agregado</span></div>
</div>
</div>
<div class="lg:col-span-3"><div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 space-y-5">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Cotización actual ({{ quoteItems.length }} prod.)</h2>
<div v-if="quoteItems.length === 0" class="text-center text-gray-400 py-10 text-sm">Buscá y agregá productos.</div>
<div v-else class="space-y-3"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-gray-200 text-left text-gray-500 text-xs uppercase"><th class="pb-2 font-medium">Producto</th><th class="pb-2 font-medium text-center w-20">Cant.</th><th class="pb-2 font-medium text-right w-32">P.Unit.</th><th class="pb-2 font-medium text-right w-32">Subtotal</th><th class="pb-2 w-10"></th></tr></thead><tbody>
<tr v-for="(item,i) in quoteItems" :key="item.producto.id" class="border-b border-gray-100"><td class="py-2 flex items-center gap-2"><img :src="item.producto.image" :alt="item.producto.name" class="w-8 h-8 rounded object-cover bg-gray-100" /><span class="truncate">{{ item.producto.name }}</span></td><td class="py-2 text-center"><input type="number" :value="item.cantidad" @input="cc(i, Number($event.target.value))" class="w-16 text-center px-2 py-1 border border-gray-300 rounded text-sm" min="1" max="999" /></td><td class="py-2 text-right"><div class="relative"><span class="absolute inset-y-0 left-2 flex items-center text-gray-400 text-sm">$</span><input type="number" :value="item.precioUnitario" @input="pc(i, Number($event.target.value))" class="w-28 text-right px-2 py-1 pl-5 border border-gray-300 rounded text-sm" min="0" /></div></td><td class="py-2 text-right font-medium text-gray-800">{{ fp(item.cantidad * item.precioUnitario) }}</td><td class="py-2 text-center"><button @click="ri(i)" class="text-red-400 hover:text-red-600 transition text-lg leading-none" style="background:none;border:none;cursor:pointer" title="Eliminar">&times;</button></td></tr>
</tbody></table></div><div class="flex justify-between items-center pt-3" style="border-top:1px solid #e5e7eb"><div class="text-sm text-gray-500">{{ quoteItems.length }} prod. · {{ totalProducts }} unidad{{ totalProducts!==1?'es':'' }}</div><div class="text-xl font-bold text-green-700">{{ fp(total) }}</div></div></div>
<div class="border-t border-gray-200 pt-5 space-y-4"><h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Datos del cliente</h2><div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><div><label class="block text-xs font-medium text-gray-600 mb-1">Nombre *</label><input v-model="customerName" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:border-green-500 outline-none" placeholder="Nombre completo" /></div><div><label class="block text-xs font-medium text-gray-600 mb-1">Email *</label><input v-model="customerEmail" type="email" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:border-green-500 outline-none" placeholder="cliente@email.com" /></div><div><label class="block text-xs font-medium text-gray-600 mb-1">Teléfono *</label><input v-model="customerPhone" type="tel" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:border-green-500 outline-none" placeholder="+569..." /></div></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-gray-600 mb-1">Empresa</label><input v-model="customerCompany" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:border-green-500 outline-none" placeholder="Nombre de la empresa" /></div></div><div><label class="block text-xs font-medium text-gray-600 mb-1">Mensaje</label><textarea v-model="customerMessage" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:border-green-500 outline-none" rows="3" placeholder="Mensaje adicional" maxlength="1000"></textarea></div></div>
<div class="border-t border-gray-200 pt-5 space-y-3"><button @click="hs" :disabled="sending" class="w-full bg-green-700 hover:bg-green-800 disabled:bg-gray-400 text-white font-medium py-3 rounded-lg transition text-sm" style="border:none;cursor:pointer;background:#15803d"><span v-if="sending">Enviando...</span><span v-else>Enviar cotización</span></button><div v-if="result" :style="result.ok?'background:#f0fdf4;color:#166534;border-color:#bbf7d0':'background:#fef2f2;color:#b91c1c;border-color:#fecaca'" class="p-4 rounded-lg text-sm border">{{ result.message }}</div><p class="text-xs text-gray-400 text-center">Se crea una orden en WooCommerce y se envía email al cliente.</p></div>
</div></div></div>

<div v-show="tab==='recibidas'"><div class="flex items-center justify-between mb-4"><h2 class="text-lg font-semibold text-gray-700">Cotizaciones recibidas</h2><button @click="rq" :disabled="loadingQuotes" class="text-sm bg-white border border-gray-300 px-3 py-1.5 rounded-lg transition" style="cursor:pointer">&#x21bb; Actualizar</button></div>
<div v-if="quoteQuotes.length === 0" class="bg-white rounded-xl border border-gray-200 p-12 text-center text-gray-400 text-sm">No hay cotizaciones todavía.</div>
<div v-else class="space-y-4">
<div v-for="q in quoteQuotes" :key="q.id" class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
<div class="flex items-center justify-between p-4 bg-gray-50" style="border-bottom:1px solid #e5e7eb"><div class="flex items-center gap-3"><span class="font-bold text-gray-800 text-sm">#{{ q.number }}</span><span :style="'font-size:.75rem;padding:0 .5rem;border-radius:9999px;font-weight:500;'+sc(q.status)">{{ sl(q.status) }}</span><span class="text-xs text-gray-400">{{ fd(q.date_created) }}</span></div><span class="text-lg font-bold text-green-700">{{ fp(Number(q.total)) }}</span></div>
<div class="p-4 grid grid-cols-1 md:grid-cols-3 gap-4"><div><p class="text-xs text-gray-400 uppercase mb-1">Cliente</p><p class="text-sm font-medium text-gray-800">{{ q.customer.name || '-' }}</p><p class="text-xs text-gray-500">{{ q.customer.email }}</p><p class="text-xs text-gray-500">{{ q.customer.phone }}</p><p v-if="q.customer.company" class="text-xs text-gray-400">{{ q.customer.company }}</p></div><div><p class="text-xs text-gray-400 uppercase mb-1">Productos</p><ul class="space-y-1"><li v-for="p in q.products" class="text-sm text-gray-700 flex justify-between"><span>{{ p.quantity }}× {{ p.name }}</span><span class="text-gray-500 ml-2">{{ fp(Number(p.total)) }}</span></li></ul></div><div v-if="q.message"><p class="text-xs text-gray-400 uppercase mb-1">Mensaje</p><p class="text-xs text-gray-500 leading-relaxed">{{ q.message }}</p></div></div></div></div></div>
</div></div>`}).mount('#cotizador-root');
      } catch (err) {
        console.error(err);
        loadingScreen.innerHTML = '<p class="text-red-500 text-sm">Error al cargar. Recargá la página.</p>';
      }
    }

    loginBtn.addEventListener('click', () => {
      const val = passwordInput.value;
      if (val === PASSWORD) {
        localStorage.setItem(AUTH_KEY, PASSWORD);
        loginError.classList.add('hidden');
        showApp();
      } else {
        loginError.classList.remove('hidden');
        passwordInput.value = '';
        passwordInput.focus();
      }
    });

    passwordInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') loginBtn.click();
    });

    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem(AUTH_KEY);
      location.reload();
    });

    // Init: check if already authenticated
    if (checkAuth()) {
      showApp();
    }
  </script>
</body>
</html>
