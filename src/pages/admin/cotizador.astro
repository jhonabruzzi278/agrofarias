---
import '../../styles/global.css';
import CotizadorAdmin from '../../components/CotizadorAdmin.vue';
export const prerender = false;
// La página no contiene secretos: el componente maneja login + panel y la
// autenticación es 100% server-side (cookie de sesión HMAC). El template se
// compila en build (SFC), por lo que no se usa eval en runtime → CSP limpio.
---
<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Cotizador Interno — Agro Farías</title>
  <link rel="icon" type="image/png" href="/logo-agrofarias.png" />
</head>
<body class="min-h-screen bg-gray-50 font-sans antialiased">
  <CotizadorAdmin client:only="vue" />
</body>
</html>
