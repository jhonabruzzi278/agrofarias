---
import Layout from '../layouts/Layout.astro';
import HeaderUpper from '../components/HeaderUpper.vue';
import HeaderLower from '../components/HeaderLower.vue';
import HeroSection from '../components/HeroSection.astro';
import CategoryBentoSection from '../components/CategoryBentoSection.astro';
import WhyUsSection from '../components/WhyUsSection.astro';
import PromoBanners from '../components/PromoBanners.astro';
import ProductGrid from '../components/ProductGrid.vue';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.vue';
import { fetchProductos, fetchCategorias } from '../lib/woocommerce';
import type { ProductoWC } from '../lib/types';

export const prerender = false;

let productos: ProductoWC[] = [];
let categorias: Array<{ id: number; name: string; slug: string; parent: number }> = [];
try {
  [productos, categorias] = await Promise.all([
    fetchProductos({ perPage: 12 }),
    fetchCategorias(),
  ]);
} catch (e) {
  console.error('[index] Failed to fetch data:', e)
}
---

<Layout>
  <header class="main-header">
    <HeaderUpper client:only="vue" categorias={categorias} />
    <HeaderLower client:only="vue" />
  </header>

  <!-- Hero: lo primero que ve el cliente -->
  <HeroSection />

  <!-- Bento de categorías destacadas -->
  <CategoryBentoSection categorias={categorias} />

  <!-- Promociones desde Sanity CMS -->
  <PromoBanners />

  <!-- Por qué elegirnos -->
  <WhyUsSection />

  <!-- Productos destacados -->
  <div class="products-placeholder min-h-[400px] contain-layout">
    <ProductGrid client:only="vue" productos={productos} title="Productos Destacados" />
  </div>

  <!-- CTA cotización -->
  <CTASection />

  <Footer client:only="vue" categorias={categorias} />
</Layout>
