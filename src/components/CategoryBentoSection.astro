---
interface Props {
  categorias?: Array<{ id: number; name: string; slug: string; parent: number; count?: number }>
}
const { categorias = [] } = Astro.props

const catImages: Record<string, string> = {
  'herbicidas': '/imagenes optimizadas/herbicidas.webp',
  'fungicidas': '/imagenes optimizadas/fungicidas.webp',
  'fertilizantes': '/imagenes optimizadas/fertilizantes.webp',
  'insecticidas': '/imagenes optimizadas/insecticidas.webp',
  'proteccion-fitosanitaria': '/imagenes optimizadas/proteccion fitosanitaria.webp',
  'herramientas-y-repuestos': '/imagenes optimizadas/herramientasrepuestos.webp',
  'nutricion-vegetal': '/imagenes optimizadas/nutricion vegetal.webp',
  'riego-y-equipamiento': '/imagenes optimizadas/riego y equipamiento.webp',
  'acaricidas': '/imagenes optimizadas/acaricidas.webp',
  'control-de-plagas': '/imagenes optimizadas/control de plagas.webp',
  'seguridad-agricola': '/imagenes optimizadas/seguridad agricola.webp',
  'foliares': '/imagenes optimizadas/foliares.webp',
}

const BENTO_ORDER = [
  'herbicidas',
  'fertilizantes',
  'fungicidas',
  'proteccion-fitosanitaria',
  'insecticidas',
  'herramientas-y-repuestos',
  'nutricion-vegetal',
  'riego-y-equipamiento',
]

const topCats = BENTO_ORDER
  .map(slug => {
    const wc = categorias.find(c => c.slug === slug)
    return wc
      ? { slug, name: wc.name, count: wc.count ?? 0, image: catImages[slug] }
      : { slug, name: slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()), count: 0, image: catImages[slug] }
  })
  .filter(c => c.image)
  .slice(0, 8)
---

<section class="bento-section py-20 bg-white">
  <div class="large-container">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-10 gap-4">
      <h2 class="text-2xl md:text-3xl font-bold font-title text-[#111]">Explorá por categoría</h2>
      <a href="/tienda" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--theme-color)] hover:underline no-underline shrink-0 hidden sm:flex">
        Ver todo →
      </a>
    </div>

    <div class="bento-grid">
      {topCats.map((cat, i) => {
        const isHero = i === 0
        const isWide = i === 3
        return (
          <a
            href={`/categoria/${cat.slug}`}
            class:list={[
              'bento-card group relative overflow-hidden rounded-2xl no-underline block',
              isHero && 'bento-hero',
              isWide && 'bento-wide',
            ]}
          >
            <!-- Imagen cubre toda la tarjeta -->
            <img
              src={cat.image}
              alt={cat.name}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
            />

            <!-- Overlay base + gradiente inferior para texto siempre legible -->
            <div class="absolute inset-0 bg-black/10"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent"></div>

            <!-- Overlay verde en hover -->
            <div class="absolute inset-0 bg-[var(--theme-color)]/15 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <!-- Label inferior -->
            <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5">
              <div class="flex items-end justify-between gap-2">
                <div class="min-w-0">
                  <h3 class:list={[
                    'font-bold text-white leading-tight drop-shadow-sm',
                    isHero ? 'text-xl sm:text-2xl' : 'text-sm sm:text-base',
                  ]}>
                    {cat.name}
                  </h3>
                  {cat.count > 0 && (
                    <p class="text-white/80 text-xs mt-1">
                      {cat.count} producto{cat.count !== 1 ? 's' : ''}
                    </p>
                  )}
                </div>
                <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/20 group-hover:bg-[var(--theme-color)] flex items-center justify-center text-white transition-all duration-300 shrink-0">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        )
      })}
    </div>
  </div>
</section>

<style>
.bento-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
}

.bento-card {
  min-height: 180px;
  background: #d4e5d4;
}

.bento-hero {
  grid-column: span 2;
  grid-row: span 2;
  min-height: 380px;
}

.bento-wide {
  grid-column: span 2;
}

@media (max-width: 900px) {
  .bento-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.375rem;
  }

  .bento-hero {
    grid-column: span 2;
    grid-row: span 1;
    min-height: 220px;
  }

  .bento-wide {
    grid-column: span 1;
  }

  .bento-card {
    min-height: 170px;
  }
}

@media (max-width: 600px) {
  .bento-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.375rem;
  }

  .bento-hero {
    grid-column: span 2;
    min-height: 210px;
  }

  .bento-wide {
    grid-column: span 2;
  }

  .bento-card {
    min-height: 150px;
  }
}
</style>
