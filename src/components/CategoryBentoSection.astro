---
interface Props {
  categorias?: Array<{ id: number; name: string; slug: string; parent: number; count?: number }>
}
const { categorias = [] } = Astro.props

const catImages: Record<string, string> = {
  'herbicidas': '/imagenes optimizadas/herbicidas.webp',
  'fungicidas': '/imagenes optimizadas/fungicidas.webp',
  'fertilizantes': '/imagenes optimizadas/fertilizantes.webp',
  'insecticidas': '/imagenes optimizadas/insecticidas.webp',
  'proteccion-fitosanitaria': '/imagenes optimizadas/proteccion fitosanitaria.webp',
  'herramientas-y-repuestos': '/imagenes optimizadas/herramientasrepuestos.webp',
  'nutricion-vegetal': '/imagenes optimizadas/nutricion vegetal.webp',
  'riego-y-equipamiento': '/imagenes optimizadas/riego y equipamiento.webp',
  'acaricidas': '/imagenes optimizadas/acaricidas.webp',
  'control-de-plagas': '/imagenes optimizadas/control de plagas.webp',
  'seguridad-agricola': '/imagenes optimizadas/seguridad agricola.webp',
  'foliares': '/imagenes optimizadas/foliares.webp',
}

const BENTO_ORDER = [
  'herbicidas',
  'fertilizantes',
  'fungicidas',
  'proteccion-fitosanitaria',
  'insecticidas',
  'herramientas-y-repuestos',
  'nutricion-vegetal',
  'riego-y-equipamiento',
]

const topCats = BENTO_ORDER
  .map(slug => {
    const wc = categorias.find(c => c.slug === slug)
    return wc
      ? { slug, name: wc.name, count: wc.count ?? 0, image: catImages[slug] }
      : { slug, name: slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()), count: 0, image: catImages[slug] }
  })
  .filter(c => c.image)
  .slice(0, 8)
---

<section class="bento-section py-16 bg-gray-50">
  <div class="large-container">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
      <div>
        <span class="text-sm font-bold text-[var(--theme-color)] uppercase tracking-widest mb-2 block">Nuestros Productos</span>
        <h2 class="text-3xl md:text-4xl font-bold font-title text-[#111]">Encontrá lo que necesitás</h2>
        <p class="text-gray-500 mt-2 max-w-lg">Líneas completas de insumos para todos tus cultivos.</p>
      </div>
      <a href="/tienda" class="inline-flex items-center gap-2 self-start sm:self-auto px-5 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-semibold text-[#111] hover:bg-[var(--theme-color)] hover:text-white hover:border-[var(--theme-color)] transition-all shadow-sm no-underline shrink-0">
        Ver toda la tienda
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="bento-grid">
      {topCats.map((cat, i) => {
        const isHero = i === 0
        const isWide = i === 3
        return (
          <a
            href={`/categoria/${cat.slug}`}
            class:list={[
              'bento-card group relative overflow-hidden rounded-2xl bg-[#e8efe9] no-underline block',
              isHero && 'bento-hero',
              isWide && 'bento-wide',
            ]}
          >
            <!-- Imagen de categoría -->
            <img
              src={cat.image}
              alt={cat.name}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-contain p-5 sm:p-8 transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Gradiente siempre visible en la parte inferior para legibilidad -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent"></div>

            <!-- Overlay de hover sutil -->
            <div class="absolute inset-0 bg-[var(--theme-color)]/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <!-- Label siempre visible, texto siempre blanco -->
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4">
              <div class="flex items-end justify-between gap-2">
                <div class="min-w-0">
                  <h3 class:list={[
                    'font-bold text-white leading-tight truncate',
                    isHero ? 'text-lg sm:text-xl' : 'text-sm sm:text-base',
                  ]}>
                    {cat.name}
                  </h3>
                  {cat.count > 0 && (
                    <p class="text-white/60 text-xs mt-0.5">
                      {cat.count} producto{cat.count !== 1 ? 's' : ''}
                    </p>
                  )}
                </div>
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/20 group-hover:bg-[var(--theme-color)] flex items-center justify-center text-white transition-all duration-300 shrink-0">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        )
      })}
    </div>
  </div>
</section>

<style>
.bento-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.625rem;
}

.bento-card {
  min-height: 170px;
}

.bento-hero {
  grid-column: span 2;
  grid-row: span 2;
  min-height: 360px;
}

.bento-wide {
  grid-column: span 2;
}

@media (max-width: 900px) {
  .bento-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .bento-hero {
    grid-column: span 2;
    grid-row: span 1;
    min-height: 200px;
  }

  .bento-wide {
    grid-column: span 1;
  }

  .bento-card {
    min-height: 160px;
  }
}

@media (max-width: 600px) {
  .bento-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .bento-hero {
    grid-column: span 2;
    min-height: 200px;
  }

  .bento-wide {
    grid-column: span 2;
  }

  .bento-card {
    min-height: 140px;
  }
}
</style>
