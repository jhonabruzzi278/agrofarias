---
---

<section class="relative overflow-hidden py-24">
  <img
    src="/asesoria-campo.webp"
    alt=""
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="lazy"
    decoding="async"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/35 to-black/25"></div>

  <div class="relative z-10 large-container text-center">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold font-title text-white mb-4 drop-shadow">
      ¿Listo para cotizar?
    </h2>
    <p class="text-white/85 text-base md:text-lg max-w-md mx-auto mb-8">
      Completá tus datos y recibís una propuesta en menos de 24 horas. Sin compromiso.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/cotizar" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[var(--theme-color)] hover:bg-[var(--theme-color-3)] text-white font-semibold rounded-lg text-sm transition-colors no-underline">
        Solicitar cotización
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/tienda" class="inline-flex items-center justify-center px-8 py-3.5 border border-white/30 hover:border-white/60 text-white font-semibold rounded-lg text-sm transition-colors no-underline">
        Ver productos
      </a>
    </div>
  </div>
</section>
