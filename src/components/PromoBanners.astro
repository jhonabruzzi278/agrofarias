---
const lineas = [
  {
    categoria: 'Herbicidas',
    tagline: 'Control de malezas',
    precio: 'Desde $12.990',
    imagen: '/imagenes optimizadas/herbicidas.webp',
    url: '/categoria/herbicidas',
  },
  {
    categoria: 'Fertilizantes',
    tagline: 'Nutrición para tus cultivos',
    precio: 'Desde $25.990',
    imagen: '/imagenes optimizadas/fertilizantes.webp',
    url: '/categoria/fertilizantes',
  },
  {
    categoria: 'Fungicidas',
    tagline: 'Protección fitosanitaria',
    precio: 'Desde $18.990',
    imagen: '/imagenes optimizadas/fungicidas.webp',
    url: '/categoria/fungicidas',
  },
]
---

<section class="py-20 bg-gray-50">
  <div class="large-container">

    <div class="flex items-end justify-between mb-10">
      <h2 class="text-2xl md:text-3xl font-bold font-title text-[#111]">Líneas destacadas</h2>
      <a href="/tienda" class="text-sm font-semibold text-[var(--theme-color)] hover:underline no-underline hidden sm:block">
        Ver todo →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {lineas.map(linea => (
        <a href={linea.url} class="group relative overflow-hidden rounded-xl no-underline block" style="min-height: 300px">
          <img
            src={linea.imagen}
            alt={linea.categoria}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"></div>

          <div class="absolute bottom-0 left-0 right-0 p-5">
            <p class="text-white/85 text-xs font-medium uppercase tracking-wider mb-1">{linea.precio}</p>
            <h3 class="text-white font-bold text-lg mb-0.5 drop-shadow-sm">{linea.categoria}</h3>
            <p class="text-white/80 text-sm">{linea.tagline}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-4 sm:hidden text-center">
      <a href="/tienda" class="text-sm font-semibold text-[var(--theme-color)] no-underline">Ver todo →</a>
    </div>

  </div>
</section>
