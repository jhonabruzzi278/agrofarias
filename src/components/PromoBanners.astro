---
const lineas = [
  {
    categoria: 'Herbicidas',
    tagline: 'Control de malezas',
    precio: 'Desde $12.990',
    imagen: '/imagenes optimizadas/herbicidas.webp',
    url: '/categoria/herbicidas',
  },
  {
    categoria: 'Fertilizantes',
    tagline: 'Nutrición para tus cultivos',
    precio: 'Desde $25.990',
    imagen: '/imagenes optimizadas/fertilizantes.webp',
    url: '/categoria/fertilizantes',
  },
  {
    categoria: 'Fungicidas',
    tagline: 'Protección fitosanitaria',
    precio: 'Desde $18.990',
    imagen: '/imagenes optimizadas/fungicidas.webp',
    url: '/categoria/fungicidas',
  },
]
---

<section class="py-24 bg-[#111]">
  <div class="large-container">

    <div class="flex items-end justify-between mb-10">
      <h2 class="text-2xl md:text-3xl font-bold font-title text-white">Líneas destacadas</h2>
      <a href="/tienda" class="text-sm font-semibold text-[var(--accent-color)] hover:underline no-underline hidden sm:block">
        Ver todo →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {lineas.map(linea => (
        <a href={linea.url} class="group relative overflow-hidden rounded-xl no-underline block" style="min-height: 380px">
          <img
            src={linea.imagen}
            alt={linea.categoria}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/45 to-black/5"></div>

          <div class="absolute bottom-0 left-0 right-0 p-6">
            <p class="text-[var(--accent-color)] text-xs font-bold uppercase tracking-wider mb-2">{linea.precio}</p>
            <h3 class="text-white font-bold text-2xl mb-1 drop-shadow-md">{linea.categoria}</h3>
            <p class="text-white/80 text-sm mb-4">{linea.tagline}</p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-white/15 group-hover:bg-[var(--theme-color)] px-3 py-1.5 rounded-full transition-colors duration-300">
              Explorar
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-6 sm:hidden text-center">
      <a href="/tienda" class="text-sm font-semibold text-[var(--accent-color)] no-underline">Ver todo →</a>
    </div>

  </div>
</section>
