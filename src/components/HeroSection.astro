---
---

<section class="hero-section relative w-full overflow-hidden" style="min-height: clamp(560px, 88vh, 800px)">
  <img
    src="/hero-campo-agrofarias.webp"
    alt="Campos agrícolas Chile"
    width="1920"
    height="1080"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />
  <!-- Overlay base más denso para garantizar legibilidad en toda resolución -->
  <div class="absolute inset-0 bg-black/30"></div>
  <!-- Gradiente izquierda → derecha intenso para texto editorial -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/35 to-transparent"></div>

  <!-- Badge flotante: stats sutiles en esquina -->
  <div class="absolute top-6 right-6 hidden lg:flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2">
    <span class="w-2 h-2 rounded-full bg-[var(--accent-color)] animate-pulse-soft"></span>
    <span class="text-white text-xs font-medium">500+ productos disponibles</span>
  </div>

  <div class="relative z-10 large-container h-full flex items-center" style="min-height: clamp(560px, 88vh, 800px)">
    <div class="max-w-xl py-20">
      <!-- Kicker con icono de trigo -->
      <p class="flex items-center gap-2 text-[var(--accent-color)] text-sm font-semibold uppercase tracking-widest mb-5">
        <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C8.5 2 6 4.5 6 8c0 2 .8 3.8 2 5l-1.5 7h3l1-4c.3.1.7.1 1 .1s.7 0 1-.1l1 4h3L15 13c1.2-1.2 2-3 2-5 0-3.5-2.5-6-5-6zm0 2c1.7 0 3 1.3 3 4 0 1.2-.4 2.3-1 3.1L13 15h-2l-1-3.9c-.6-.8-1-1.9-1-3.1 0-2.7 1.3-4 3-4z"/>
        </svg>
        Insumos Agrícolas · Chile
      </p>

      <h1 class="text-6xl sm:text-7xl font-bold text-white leading-[1.05] mb-6 font-title">
        Todo para<br />tu cultivo
      </h1>

      <p class="text-white/90 text-lg mb-10 max-w-md leading-relaxed">
        Herbicidas, fungicidas, fertilizantes y equipamiento con despacho a todo Chile.
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/tienda" class="inline-flex items-center justify-center gap-2 px-9 py-4 bg-[var(--theme-color)] hover:bg-[var(--theme-color-3)] text-white font-semibold rounded-lg text-sm transition-colors no-underline shadow-lg shadow-black/20">
          Ver productos
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/cotizacion" class="inline-flex items-center justify-center px-9 py-4 border border-white/30 hover:border-white/60 text-white font-semibold rounded-lg text-sm transition-colors no-underline backdrop-blur-sm bg-white/5 hover:bg-white/10">
          Cotizar ahora
        </a>
      </div>
    </div>
  </div>
</section>
