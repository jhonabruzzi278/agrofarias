---
---

<section class="hero-section relative w-full overflow-hidden" style="min-height: clamp(560px, 88vh, 800px)">
  <img
    src="/hero-campo-agrofarias.webp"
    alt="Campos agrícolas Chile"
    width="1920"
    height="1080"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />
  <!-- Overlay base suave para mobile (garantiza legibilidad en toda la imagen) -->
  <div class="absolute inset-0 bg-black/25"></div>
  <!-- Gradiente izquierda → derecha más intenso para desktop -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/20 to-transparent"></div>

  <div class="relative z-10 large-container h-full flex items-center" style="min-height: clamp(560px, 88vh, 800px)">
    <div class="max-w-xl py-20">
      <p class="text-[var(--accent-color)] text-sm font-semibold uppercase tracking-widest mb-4">Insumos Agrícolas · Chile</p>

      <h1 class="text-5xl sm:text-6xl font-bold text-white leading-tight mb-5 font-title">
        Todo para<br />tu cultivo
      </h1>

      <p class="text-white/90 text-lg mb-10 max-w-md leading-relaxed">
        Herbicidas, fungicidas, fertilizantes y equipamiento con despacho a todo Chile.
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/tienda" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[var(--theme-color)] hover:bg-[var(--theme-color-3)] text-white font-semibold rounded-lg text-sm transition-colors no-underline">
          Ver productos
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/cotizar" class="inline-flex items-center justify-center px-8 py-3.5 border border-white/30 hover:border-white/60 text-white font-semibold rounded-lg text-sm transition-colors no-underline">
          Cotizar ahora
        </a>
      </div>
    </div>
  </div>
</section>
