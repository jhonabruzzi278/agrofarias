---
---

<section class="hero-section relative w-full overflow-hidden" style="min-height: clamp(480px, 90vh, 780px)">
  <!-- Background image -->
  <img
    src="/farmer-spraying-fertilizer-pest-control-and-plant-2026-03-04-17-37-40-utc.JPG"
    alt="Agricultor aplicando insumos en el campo"
    width="1920"
    height="1080"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />

  <!-- Gradient overlay: left-dark for text, right-transparent -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/50 to-black/20"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

  <!-- Content -->
  <div class="relative z-10 large-container h-full flex items-center" style="min-height: clamp(480px, 90vh, 780px)">
    <div class="max-w-2xl py-16">

      <!-- Badge -->
      <span class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-color)] animate-pulse inline-block"></span>
        Agro Farías — Insumos Agrícolas
      </span>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-5 font-title">
        Todo para<br />
        <span class="text-[var(--accent-color)]">tu cultivo</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-white/80 mb-8 max-w-xl leading-relaxed">
        Herbicidas, fungicidas, fertilizantes, equipamiento y más — entregamos a todo Chile con asesoría técnica especializada.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 mb-10">
        <a
          href="/tienda"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[var(--theme-color)] hover:bg-[var(--theme-color-3)] text-white font-bold rounded-xl text-base transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 no-underline"
        >
          Ver tienda
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href="/cotizar"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 text-white font-semibold rounded-xl text-base transition-all duration-300 no-underline"
        >
          Solicitar cotización
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <span class="flex items-center gap-1.5 text-white/70 text-sm">
          <svg class="w-4 h-4 text-[var(--accent-color)]" viewBox="0 0 24 24" fill="currentColor"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Envío a todo Chile
        </span>
        <span class="flex items-center gap-1.5 text-white/70 text-sm">
          <svg class="w-4 h-4 text-[var(--accent-color)]" viewBox="0 0 24 24" fill="currentColor"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Asesoría técnica
        </span>
        <span class="flex items-center gap-1.5 text-white/70 text-sm">
          <svg class="w-4 h-4 text-[var(--accent-color)]" viewBox="0 0 24 24" fill="currentColor"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Productos certificados
        </span>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 animate-bounce hidden sm:flex flex-col items-center gap-1">
    <span class="text-white/40 text-xs uppercase tracking-widest">Scroll</span>
    <svg class="w-5 h-5 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
  </div>
</section>
