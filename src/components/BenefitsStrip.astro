---
import { SITE_CONFIG } from '../lib/config';

const benefits = [
  {
    icon: 'fas fa-truck',
    title: 'Despacho a todo Chile',
    desc: 'Enviamos a tu región',
    href: null,
  },
  {
    icon: 'fas fa-user-tie',
    title: 'Asesoría técnica',
    desc: 'Equipo especializado',
    href: SITE_CONFIG.phoneHref,
  },
  {
    icon: 'fab fa-whatsapp',
    title: 'Atención por WhatsApp',
    desc: SITE_CONFIG.phone,
    href: SITE_CONFIG.social.whatsapp,
  },
  {
    icon: 'fas fa-file-invoice',
    title: 'Cotización sin compromiso',
    desc: 'Precios a tu medida',
    href: '/cotizacion',
  },
  {
    icon: 'fas fa-clock',
    title: 'Lun-Vie 8:00 - 17:30',
    desc: 'Solo días hábiles',
    href: null,
  },
];
---

<section class="benefits-strip bg-white border-b border-gray-100">
  <div class="large-container">
    <!-- Desktop: 5 columnas con divisores -->
    <div class="hidden md:grid md:grid-cols-3 lg:grid-cols-5 divide-x divide-gray-100">
      {benefits.map((b) => {
        const Tag = b.href ? 'a' : 'div';
        return (
          <Tag
            href={b.href ?? undefined}
            target={b.href?.startsWith('http') ? '_blank' : undefined}
            rel={b.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
            class:list={[
              'flex items-center gap-3 py-4 px-5 group',
              b.href ? 'hover:bg-gray-50 transition-colors cursor-pointer' : '',
            ]}
          >
            <div class="w-9 h-9 rounded-lg bg-theme/8 flex items-center justify-center flex-shrink-0 group-hover:bg-theme/15 transition-colors">
              <i class:list={[b.icon, 'text-[var(--theme-color)] text-sm']}></i>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-[#111] leading-tight truncate">{b.title}</p>
              <p class="text-[11px] text-gray-500 leading-tight mt-0.5 truncate">{b.desc}</p>
            </div>
          </Tag>
        );
      })}
    </div>

    <!-- Mobile: scroll horizontal -->
    <div class="flex md:hidden gap-3 overflow-x-auto py-3 scrollbar-hide px-1">
      {benefits.map((b) => (
        <a
          href={b.href ?? '#'}
          class="flex items-center gap-2 flex-shrink-0 bg-gray-50 border border-gray-100 rounded-xl px-3 py-2"
        >
          <i class:list={[b.icon, 'text-[var(--theme-color)] text-sm flex-shrink-0']}></i>
          <span class="text-xs font-semibold text-[#111] whitespace-nowrap">{b.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>
