---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.vue';
import Toast from '../components/Toast.vue';
import { SITE_CONFIG } from '../lib/config';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string
  description?: string
  image?: string
  canonical?: string
  noindex?: boolean
  type?: 'website' | 'article' | 'product'
}
const { title = 'Agro Farías', description = 'Insumos, herramientas y soluciones agrícolas con atención personalizada y despacho confiable.', image = '/logo-agrofarias.png', canonical, noindex = false, type = 'website' } = Astro.props;
const fullTitle = `${title} | Agro Farías — Insumos Agrícolas`;
const siteUrl = SITE_CONFIG.url;
const pageUrl = canonical || (Astro.url ? Astro.url.href : siteUrl);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-agrofarias.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <ClientRouter />

    <link rel="prefetch" href="/tienda" />
    <link rel="prefetch" href="/cotizacion" />

    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Agro Farías" />
    <meta property="og:locale" content="es_CL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="preconnect" href={SITE_CONFIG.url} />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Rethink+Sans:ital,wght@0,400..700;1,400..700&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Rethink+Sans:ital,wght@0,400..700;1,400..700&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet" /></noscript>

    <link rel="preload" href="/assets/css/font-awesome-all.css" as="style" />
    <link rel="preload" href="/assets/fonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/fa-brands-400.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/assets/css/font-awesome-all.css" rel="stylesheet" media="print" onload="this.media='all'" />
    <link href="/assets/css/flaticon.css" rel="stylesheet" media="print" onload="this.media='all'" />

    <style>
      @font-face { font-display: swap; }
    </style>

    <script type="application/ld+json" set:html={JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Agro Farías",
    "url": siteUrl,
    "logo": `${siteUrl}/logo-agrofarias.png`,
    "description": description,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ruta 66 km 95850",
      "addressLocality": "San Pedro, Melipilla",
      "addressRegion": "Región Metropolitana",
      "addressCountry": "CL"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": SITE_CONFIG.phone.replace(/ /g, '-').replace('+', ''),
      "contactType": "customer service",
      "email": SITE_CONFIG.email,
      "availableLanguage": ["es"]
    },
    "sameAs": [
      SITE_CONFIG.social.facebook,
      SITE_CONFIG.social.instagram
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Store",
    "name": "Agro Farías — Insumos Agrícolas",
    "url": siteUrl,
    "image": `${siteUrl}/logo-agrofarias.png`,
    "description": description,
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "08:00", "closes": "18:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
    ],
    "currenciesAccepted": "CLP",
    "priceRange": "$"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Agro Farías",
    "url": siteUrl,
    "description": description,
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": `${siteUrl}/tienda?search={search_term_string}` },
      "query-input": "required name=search_term_string"
    }
  }
])} />
  </head>
  <body>
    <!-- Loading bar for SPA navigation -->
    <div id="nav-loading-bar" class="fixed top-0 left-0 h-[3px] bg-[var(--accent-color)] z-[9999] w-0 opacity-0 transition-all duration-200"></div>

    <!-- Skeleton overlay mientras carga la tienda (navegación SPA) -->
    <div id="route-skeleton" aria-hidden="true">
      <div class="route-skeleton-inner">
        <div class="route-skeleton-grid">
          {Array.from({ length: 8 }).map(() => (
            <div class="rs-card">
              <div class="rs-img"></div>
              <div class="rs-body">
                <div class="rs-line rs-w33"></div>
                <div class="rs-line rs-w75"></div>
                <div class="rs-line rs-w50"></div>
                <div class="rs-btn"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <WhatsAppButton client:only="vue" />
    <Toast client:only="vue" />

    <script>
      (function() {
        var bar = document.getElementById('nav-loading-bar');
        if (!bar) return;
        document.addEventListener('astro:before-preparation', function() {
          bar.style.transition = 'none';
          bar.style.width = '0';
          bar.style.opacity = '1';
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              bar.style.transition = 'width 800ms ease-out, opacity 300ms ease';
              bar.style.width = '70%';
            });
          });
        });
        document.addEventListener('astro:after-preparation', function() {
          bar.style.width = '100%';
          setTimeout(function() {
            bar.style.opacity = '0';
            setTimeout(function() { bar.style.width = '0'; }, 300);
          }, 100);
        });
      })();
    </script>

    <script>
      // Skeleton overlay solo al navegar hacia /tienda (catálogo pesado).
      (function() {
        function skel() { return document.getElementById('route-skeleton'); }
        function isTienda(to) {
          try { return new URL(to, location.origin).pathname === '/tienda'; } catch (e) { return false; }
        }
        function hide() { var s = skel(); if (s) s.classList.remove('is-visible'); }
        document.addEventListener('astro:before-preparation', function(e) {
          if (e && e.to && isTienda(e.to)) { var s = skel(); if (s) s.classList.add('is-visible'); }
        });
        document.addEventListener('astro:after-swap', hide);
        document.addEventListener('astro:page-load', hide);
      })();
    </script>

    <style is:global>
      #route-skeleton {
        position: fixed;
        inset: 0;
        z-index: 9990;
        background: #f9fafb;
        opacity: 0;
        pointer-events: none;
        overflow: hidden;
        transition: opacity 0.15s ease;
      }
      #route-skeleton.is-visible { opacity: 1; pointer-events: auto; }
      .route-skeleton-inner { max-width: 1200px; margin: 0 auto; padding: 104px 1.5rem 2rem; }
      .route-skeleton-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      @media (min-width: 640px) { .route-skeleton-grid { grid-template-columns: repeat(3, 1fr); } }
      @media (min-width: 1024px) { .route-skeleton-grid { grid-template-columns: repeat(4, 1fr); } }
      .rs-card { background: #fff; border: 1px solid #f0f0f0; border-radius: 0.75rem; overflow: hidden; animation: rsPulse 1.5s ease-in-out infinite; }
      .rs-img { aspect-ratio: 4 / 3; background: #e5e7eb; }
      .rs-body { padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem; }
      .rs-line { height: 0.85rem; background: #e5e7eb; border-radius: 0.375rem; }
      .rs-w33 { width: 33%; } .rs-w50 { width: 50%; } .rs-w75 { width: 75%; }
      .rs-btn { height: 2rem; background: #e5e7eb; border-radius: 0.5rem; margin-top: 0.25rem; }
      @keyframes rsPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
      @media (prefers-reduced-motion: reduce) { .rs-card { animation: none; } }
    </style>

    <style is:global>
      #nav-loading-bar {
        will-change: width, opacity;
        box-shadow: 0 0 8px rgba(245, 176, 32, 0.5);
      }
      [data-astro-transition="forward"] main,
      [data-astro-transition="back"] main {
        animation: pageIn 0.3s ease-out;
      }
      @keyframes pageIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    padding: 0.75rem 1.5rem;
    background: var(--theme-color);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 8px 8px;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
    outline: 3px solid var(--accent-color);
    outline-offset: 2px;
  }

  *:focus-visible {
    outline: 3px solid var(--theme-color);
    outline-offset: 2px;
    border-radius: 2px;
  }

  a:focus-visible {
    outline-offset: 4px;
  }

  button:focus-visible {
    outline-offset: 2px;
  }

  .theme-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    color: #fff;
    background: var(--theme-color);
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    font-family: var(--text-font);
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    overflow: hidden;
  }

  .theme-btn:hover {
    background: var(--theme-color-3);
    color: #fff;
  }

  .theme-btn:focus-visible {
    outline: 3px solid var(--accent-color);
    outline-offset: 3px;
  }

  .theme-btn.btn-one {
    background: var(--theme-color);
    color: #fff;
  }

  .theme-btn.btn-one:hover {
    background: var(--theme-color-3);
    color: #fff;
  }

  .theme-btn.btn-two {
    background: #fff;
    color: var(--theme-color);
    border: 2px solid var(--theme-color);
  }

  .theme-btn.btn-two:hover {
    background: var(--theme-color);
    color: #fff;
  }

  .sec-title {
    position: relative;
    display: block;
    margin-bottom: 2rem;
  }

  .sec-title h2 {
    font-family: var(--font-title);
    font-size: 2.25rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--title-color);
    margin: 0;
  }

  @media (max-width: 767px) {
    .sec-title h2 {
      font-size: 1.75rem;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(-30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .animate-fade-in-left {
    animation: fadeInLeft 0.6s ease-out forwards;
    opacity: 0;
  }

  .animate-fade-in-right {
    animation: fadeInRight 0.6s ease-out forwards;
    opacity: 0;
  }

  .animate-scale-in {
    animation: scaleIn 0.5s ease-out forwards;
    opacity: 0;
  }

  .stagger-1 { animation-delay: 0.1s; }
  .stagger-2 { animation-delay: 0.2s; }
  .stagger-3 { animation-delay: 0.3s; }
  .stagger-4 { animation-delay: 0.4s; }
  .stagger-5 { animation-delay: 0.5s; }
  .stagger-6 { animation-delay: 0.6s; }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
